{
  "name": "rzl-online-hilfe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "predev": "pnpm migrate:nav",
    "dev": "astro dev",
    "prebuild": "pnpm migrate:nav && pnpm migrate:redirects",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test scripts/**/*.test.ts",
    "migrate:content": "tsx scripts/migrate-content.ts",
    "migrate:nav": "tsx scripts/migrate-nav-from-pages.ts",
    "migrate:redirects": "tsx scripts/build-redirect-map.ts",
    "validate:urls": "tsx scripts/validate-urls.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4",
    "github-slugger": "2.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  }
}
