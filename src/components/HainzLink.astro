---
/**
 * Header entry point for "Frag Hainz!", RZL's AI assistant.
 * Ported from the legacy MkDocs `overrides/main.html` header button
 * (`config.theme.hainz`), which linked to https://hainz.rzlsoftware.at
 * using the icon from `docs/img/herz_neuronen.svg`.
 *
 * Rendered via the Starlight `SocialIcons` component override, the slot
 * intended for extra icon links in the site header.
 */
const hainzUrl = 'https://hainz.rzlsoftware.at';
---

