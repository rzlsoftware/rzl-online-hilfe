			c-3.7,0-6.6,3-6.6,6.6v1.4l2,1.9l2.1-1.9v-1.3c0-1.4,1.1-2.5,2.6-2.5s2.6,1.1,2.6,2.5c0,0.7-0.6,1.6-1.2,2.2L20,19.7l0,0l-5.9-5.6
