<style>
	@layer starlight.core {
		.hainz-link {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		.hainz-link:hover {
			color: var(--sl-color-white);
		}
		.hainz-link svg {
			width: 1.5rem;
			height: 1.5rem;
			fill: currentColor;
