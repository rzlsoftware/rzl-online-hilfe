---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Seite nicht gefunden',
		template: 'splash',
		editUrl: false,
		hideFooter: true,
		pagefind: false,
		head: [
			{
				tag: 'script',
				content: `
          (function () {
            // Fallback for legacy MkDocs URLs that don't fit in Azure Static Web
            // Apps' 20 KB route-config limit; see scripts/build-redirect-map.ts.
            var path = window.location.pathname;
            var candidates = [path];
            try {
              candidates.push(decodeURIComponent(path));
            } catch (error) {
              // ignore malformed percent-escapes
            }
            if (!path.endsWith('/')) candidates.push(path + '/');
            fetch('/legacy-redirects.json')
              .then(function (response) {
                return response.ok ? response.json() : null;
              })
              .then(function (map) {
                if (!map) return;
                for (var i = 0; i < candidates.length; i += 1) {
                  var target = map[candidates[i]];
                  if (target) {
                    window.location.replace(target);
                    return;
                  }
                }
              })
              .catch(function () {
                // No redirect map available; leave the 404 message in place.
              });
          })();
        `,
			},
		],
	}}
>
	<p>
		Die aufgerufene Seite konnte leider nicht gefunden werden. Nutzen Sie die Suche oder kehren Sie zur Startseite
		zurück.
	</p>
	<p>
		<a href="/">Zur Startseite</a>
	</p>
</StarlightPage>
